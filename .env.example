# Local dev
PORT=8080
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gigaflow
GCP_PROJECT_ID=gigaflow-dev
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json  # local Firebase token verify

# AI workout generation providers (E7) — set at least one to enable real generation
# GEMINI_API_KEY=
# GEMINI_MODEL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Vertex AI Gemini provider (alternative to AI Studio GEMINI_API_KEY; uses ADC, no key)
# Vertex uses Application Default Credentials — locally run `gcloud auth application-default login`;
# on Cloud Run the runtime SA supplies ADC (needs roles/aiplatform.user, granted by Terraform).
# VERTEX_PROJECT_ID=            # defaults to GCP_PROJECT_ID
# VERTEX_LOCATION=global
# VERTEX_MODEL=gemini-2.5-flash
# AI_PROVIDER_ORDER=vertex,gemini,openai   # the switch: order = priority; unset = default gemini,openai
